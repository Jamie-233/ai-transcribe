# 复制为 .env 后按需修改

# --- 语音识别 ---
# 本地 faster-whisper 模型：tiny / base / small / medium / large-v3 / turbo（越大越准、越慢）
WHISPER_MODEL=small
WHISPER_DEVICE=auto
# CPU 建议 int8，NVIDIA GPU 建议 float16
WHISPER_COMPUTE_TYPE=int8

# 填写后可在界面里选择 “OpenAI Whisper API”，也会默认用于纠错模型
OPENAI_API_KEY=

# --- 纠错与总结用的大模型（任意 OpenAI 兼容接口）---
# 方案 A：OpenAI 官方（只需上面的 OPENAI_API_KEY）
LLM_MODEL=gpt-4o-mini

# 方案 B：本地 Ollama（完全离线，先 ollama pull qwen2.5:7b）
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# 方案 C：DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat
